{
  "name": "@familiar-ai/core",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AidanZealley/familiar.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http/index.ts",
    "./extensions": "./src/extensions.ts",
    "./diagnostics": "./src/diagnostics.ts",
    "./storage/memory": "./src/storage/memory.ts",
    "./models": "./src/models/index.ts",
    "./models/openai": "./src/models/openai.ts",
    "./models/openrouter": "./src/models/openrouter.ts",
    "./models/faux": "./src/models/faux.ts",
    "./models/scripted": "./src/models/scripted.ts",
    "./node": "./src/node/index.ts"
  },
  "imports": {
    "#default-fetch": {
      "workerd": "./src/global-fetch.ts",
      "browser": "./src/global-fetch.ts",
      "node": "./src/node/fetch.ts",
      "default": "./src/global-fetch.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./http": "./dist/http/index.js",
      "./extensions": "./dist/extensions.js",
      "./diagnostics": "./dist/diagnostics.js",
      "./storage/memory": "./dist/storage/memory.js",
      "./models": "./dist/models/index.js",
      "./models/openai": "./dist/models/openai.js",
      "./models/openrouter": "./dist/models/openrouter.js",
      "./models/faux": "./dist/models/faux.js",
      "./models/scripted": "./dist/models/scripted.js",
      "./node": "./dist/node/index.js"
    },
    "imports": {
      "#default-fetch": {
        "workerd": "./dist/global-fetch.js",
        "browser": "./dist/global-fetch.js",
        "node": "./dist/node/fetch.js",
        "default": "./dist/global-fetch.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/chord": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-durable": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "croner": "11.0.0",
    "hono": "catalog:",
    "minisearch": "7.2.0",
    "node-fetch": "3.3.2",
    "request-filtering-agent": "3.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "catalog:"
  }
