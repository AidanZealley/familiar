<?xml version="1.0"?>
<!--
  The computer's desktop: one workspace, a taskbar with a launcher menu, the
  open windows and a clock. Nothing here logs out or powers off: the agent
  owns the display, and ends if it goes.
-->
<JWM>
    <RootMenu onroot="123">
        <Program icon="utilities-terminal" label="Terminal">urxvt</Program>
    </RootMenu>

    <Desktops width="1" height="1">
        <Background type="solid">#2E3440</Background>
    </Desktops>

    <Tray x="0" y="-1" height="28" autohide="off">
        <TrayButton label="Menu">root:1</TrayButton>
        <Spacer width="2"/>
        <TaskList maxwidth="256"/>
        <Dock/>
        <Clock format="%H:%M"/>
    </Tray>

    <WindowStyle decorations="flat">
        <Font>Sans-11:bold</Font>
        <Width>3</Width>
        <Foreground>#FFFFFF</Foreground>
        <Background>#555555</Background>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#0077CC</Background>
        </Active>
    </WindowStyle>
    <TrayStyle decorations="flat">
        <Font>Sans-11</Font>
        <Background>#333333</Background>
        <Foreground>#FFFFFF</Foreground>
    </TrayStyle>
    <TaskListStyle list="all" group="false">
        <Font>Sans-11</Font>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#555555</Background>
        </Active>
        <Foreground>#FFFFFF</Foreground>
        <Background>#333333</Background>
    </TaskListStyle>
    <MenuStyle decorations="flat">
        <Font>Sans-11</Font>
        <Foreground>#FFFFFF</Foreground>
        <Background>#333333</Background>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#0077CC</Background>
        </Active>
    </MenuStyle>

    <FocusModel>click</FocusModel>
    <SnapMode distance="10">border</SnapMode>
    <MoveMode>opaque</MoveMode>
    <ResizeMode>opaque</ResizeMode>

    <Key mask="A" key="Tab">nextstacked</Key>
    <Key mask="A" key="F4">close</Key>
    <Key mask="A" key="F2">window</Key>
    <Key mask="A" key="F10">maximize</Key>
    <Key key="Up">up</Key>
    <Key key="Down">down</Key>
    <Key key="Left">left</Key>
    <Key key="Right">right</Key>
    <Key key="Return">select</Key>
    <Key key="Escape">escape</Key>
</JWM>
