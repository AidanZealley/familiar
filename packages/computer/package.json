{
  "name": "@familiar-ai/computer",
  "version": "0.0.0",
  "config": {
    "image": "ghcr.io/aidanzealley/familiar-computer"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AidanZealley/familiar.git",
    "directory": "packages/computer"
  },
  "exports": {
    ".": "./src/index.ts",
    "./docker": "./src/docker/index.ts"
  },
  "files": [
    "dist",
    "image.json"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./docker": "./dist/docker/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "image:key": "node scripts/image-key.ts",
    "image": "node scripts/image-key.ts --build"
  },
  "peerDependencies": {
    "@familiar-ai/core": "workspace:*",
    "hono": "catalog:"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "playwright": "1.65.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@familiar-ai/core": "workspace:*",
    "hono": "catalog:",
    "rolldown": "1.2.15"
  }
}
