{
  "name": "@familiar-ai/computer",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AidanZealley/familiar.git",
    "directory": "packages/computer"
  },
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent/index.ts",
    "./cloudflare": "./src/cloudflare/index.ts",
    "./docker": "./src/docker/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "familiar-computer": "./dist/agent/main.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./agent": "./dist/agent/index.js",
      "./cloudflare": "./dist/cloudflare/index.js",
      "./docker": "./dist/docker/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "image": "docker build -t ghcr.io/aidanzealley/familiar-computer:dev -f Dockerfile ../.."
  },
  "peerDependencies": {
    "@familiar-ai/core": "workspace:*",
    "hono": "catalog:"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "playwright": "1.65.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@familiar-ai/core": "workspace:*",
    "hono": "catalog:"
  }
}
