# Copy to .env, which git ignores, and fill in.

# What you sign in with. Long and unique: it's the only lock on your Familiar.
FAMILIAR_PASSWORD=

# Signs session cookies. At least 32 random characters, such as from
# `openssl rand -base64 32`. Changing it signs every browser out.
FAMILIAR_SESSION_SECRET=

# The model, through OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional.
# FAMILIAR_NAME=Familiar
# FAMILIAR_OWNER=Sam
# FAMILIAR_DATA_DIR=./data
# PORT=4320
