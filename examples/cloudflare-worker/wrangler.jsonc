{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familiar-cloudflare-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-23",
  "durable_objects": {
    "bindings": [{ "name": "BOTS", "class_name": "Bot" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bot"] }],
  "vars": { "TIME_ZONE": "Europe/London" },
  // Set with `wrangler secret put`, or in .dev.vars for `wrangler dev`.
  "secrets": { "required": ["FAMILIAR_TOKEN"] },
}
