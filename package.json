{
  "name": "familiar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @familiar-ai/daemon --filter @familiar-ai/web dev",
    "dev:live": "pnpm --filter @familiar-ai/web dev:live",
    "build": "pnpm --filter @familiar-ai/web build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:docs": "pnpm --filter @familiar-ai/docs build",
    "start": "pnpm --filter @familiar-ai/daemon start",
    "sign-in": "pnpm --filter @familiar-ai/daemon sign-in",
    "eval:recall": "pnpm --filter @familiar-ai/daemon eval:recall",
    "eval:unfiled": "pnpm --filter @familiar-ai/daemon eval:unfiled",
    "eval:core": "pnpm --filter @familiar-ai/daemon eval:core",
    "eval:use": "pnpm --filter @familiar-ai/daemon eval:use",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:docs": "pnpm --filter @familiar-ai/docs dev",
    "service:install": "pnpm build && node apps/daemon/src/cli/install-service.ts",
    "service:logs": "node apps/daemon/src/cli.ts logs",
    "test": "vitest run",
    "test:cloudflare": "pnpm --filter @familiar-ai/cloudflare test",
    "bundle": "pnpm --filter @familiar-ai/daemon bundle",
    "test:release": "pnpm --filter @familiar-ai/daemon test:release",
    "test:packages": "node scripts/verify-packages.ts"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
