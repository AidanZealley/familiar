{
  "name": "familiar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @familiar/daemon --filter @familiar/web dev",
    "build": "pnpm --filter @familiar/web build",
    "start": "pnpm --filter @familiar/daemon start",
    "sign-in": "pnpm --filter @familiar/daemon sign-in",
    "eval:memory": "pnpm --filter @familiar/daemon eval:memory",
    "eval:memory:rejudge": "pnpm --filter @familiar/daemon eval:memory:rejudge",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:web": "pnpm --filter @familiar/web dev",
    "dev:demo": "pnpm --parallel --filter @familiar/daemon --filter @familiar/web dev:demo",
    "service:install": "pnpm build && node apps/daemon/src/install-service.ts",
    "service:logs": "journalctl --user -u familiar -f",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
