{
  "name": "@familiar-ai/daemon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/cli.ts serve",
    "dev:demo": "node --watch src/demo/main.ts",
    "start": "node src/cli.ts serve",
    "sign-in": "node src/cli.ts sign-in",
    "eval:memory": "node src/memory-eval/main.ts",
    "eval:memory:rejudge": "node src/memory-eval/rejudge.ts",
    "eval:recall": "node src/memory-eval/recall-main.ts",
    "eval:unfiled": "node src/memory-eval/unfiled-main.ts",
    "typecheck": "tsc",
    "bundle": "pnpm --filter @familiar-ai/web build && node scripts/bundle.ts",
    "test:release": "node scripts/verify-release.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-durable": "catalog:",
    "@familiar-ai/core": "workspace:*",
    "@familiar-ai/plugin-web": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/client": "catalog:",
    "cross-spawn": "7.0.6",
    "hono": "catalog:",
    "node-fetch": "3.3.2",
    "piscina": "5.3.2",
    "request-filtering-agent": "3.2.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@types/cross-spawn": "6.0.6",
    "@types/web-push": "3.6.4",
    "rolldown": "1.2.15"
  }
}
