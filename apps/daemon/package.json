{
  "name": "@familiar-ai/daemon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/demo/main.ts",
    "dev:live": "node --watch src/cli.ts serve",
    "start": "node src/cli.ts serve",
    "sign-in": "node src/cli.ts sign-in",
    "eval:recall": "node src/memory-eval/recall-main.ts",
    "eval:unfiled": "node src/memory-eval/unfiled-main.ts",
    "eval:longmem": "node src/memory-eval/longmem-main.ts",
    "eval:longmem-retrieval": "node src/memory-eval/longmem-retrieval-main.ts",
    "eval:memory-scenarios": "node src/memory-eval/scenarios-main.ts",
    "typecheck": "tsc",
    "bundle": "pnpm --filter @familiar-ai/web build && node scripts/bundle.ts",
    "test:release": "node scripts/verify-release.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-durable": "catalog:",
    "@familiar-ai/computer": "workspace:*",
    "@familiar-ai/core": "workspace:*",
    "@hono/node-server": "2.1.8",
    "@mdream/js": "2.0.3",
    "@modelcontextprotocol/client": "catalog:",
    "cross-spawn": "7.0.6",
    "hono": "catalog:",
    "piscina": "5.3.2",
    "web-push": "3.6.7",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@types/cross-spawn": "6.0.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "rolldown": "1.2.15"
  }
}
