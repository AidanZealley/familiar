---
import { pitch } from './content'
import Spec from './Spec.astro'
---

<section class="sheet-wrap hero">
  <h1>A <span class="mark">portable</span> AI assistant with memory you can <span class="mark">run anywhere</span> and build into <span class="mark">your app</span>.</h1>
  <p class="lede">{pitch}</p>
  <div class="spec-col"><Spec /></div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 1.5rem;
    padding-block: clamp(3rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  h1 {
    grid-column: 1 / span 9;
    grid-row: 1;
    font-size: clamp(2.125rem, 5.6vw, 4.75rem);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  /* Clone the flat underline on wrapped lines without colouring the text. */
  .mark {
    --ink: color-mix(in oklch, var(--accent) 24%, transparent);
    background-image: linear-gradient(var(--ink), var(--ink));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 100% 0.36em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .lede {
    grid-column: 1 / span 6;
    grid-row: 2;
    margin-top: 2rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--muted);
    text-wrap: pretty;
  }

  .spec-col {
    grid-column: 9 / span 4;
    grid-row: 2;
    align-self: end;
    margin-top: 2rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
  }

  @media (max-width: 56rem) {
    h1,
    .lede,
    .spec-col {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .spec-col :global(.spec) {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }

  }
</style>
