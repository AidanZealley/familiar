---
import {
  ArrowRight,
  Cloud,
  Download,
  GitBranch,
  House,
  NotebookPen,
  PackageOpen,
  Puzzle,
  SquareTerminal,
} from '@lucide/astro'
import Shell from './Shell.astro'
import Hero from './Hero.astro'
import {
  demos,
  highlights,
  installers,
  links,
  paths,
  signIn,
} from './content'

const highlightIcons = {
  'Self-hosted': House,
  'Long-term memory': NotebookPen,
  'Tools and plugins': Puzzle,
  Portable: Cloud,
  Embeddable: PackageOpen,
}
---

<Shell title="Familiar">
  <header class="wrap top">
    <a class="wordmark" href="/familiar/">familiar</a>
    <nav aria-label="Primary">
      <a href={links.docs}>Docs</a>
      <a href={links.build}>Build</a>
      <a href={links.github}>GitHub</a>
      <a class="nav-install" href="#install">
        <Download size={16} />
        Install
      </a>
    </nav>
  </header>

  <main id="main">
    <Hero />

    <section class="wrap install" id="install" aria-labelledby="install-title">
      <div class="panel">
        <div class="panel-head">
          <h2 id="install-title">
            <SquareTerminal size={16} />
            Install
          </h2>
          <fieldset class="tabs">
            <legend class="sr-only">Operating system</legend>
            {
              installers.map((installer, index) => (
                <label>
                  <input
                    type="radio"
                    name="os-sheet"
                    value={installer.id}
                    checked={index === 0}
                  />
                  {installer.short}
                </label>
              ))
            }
          </fieldset>
          <a class="guide" href={links.install}>
            Install guide
            <ArrowRight size={16} />
          </a>
        </div>
        {
          installers.map((installer) => (
            <div class="command" data-os={installer.id}>
              <span class="sr-only">{installer.os}:</span>
              <span class="prompt" aria-hidden="true">
                {installer.prompt}
              </span>
              <code>{installer.command}</code>
              <button type="button" data-copy={installer.command} hidden>
                Copy
              </button>
            </div>
          ))
        }
        <p class="panel-foot">{signIn}</p>
      </div>
    </section>

    <section class="wrap features" aria-labelledby="features-title">
      <div class="section-head">
        <h2 id="features-title">Features</h2>
      </div>
      <ol class="grid">
        {
          highlights.map((highlight, index) => {
            const Icon = highlightIcons[highlight.label]
            return (
              <li class={`cell cell-${index + 1}`}>
                <span class="cell-top" aria-hidden="true">
                  <Icon size={20} class="cell-icon" />
                </span>
                <h3>{highlight.label}</h3>
                <p>{highlight.line}</p>
              </li>
            )
          })
        }
      </ol>
    </section>

    <section class="wrap paths" aria-labelledby="paths-title">
      <h2 id="paths-title" class="sr-only">Where to next</h2>
      <ul>
        {
          paths.map((path) => {
            return (
              <li>
                <a href={path.href}>
                  <span class="path-label">
                    <span class="path-text">{path.label}</span>
                    <ArrowRight class="arrow" aria-hidden="true" />
                  </span>
                  <span class="path-line">{path.line}</span>
                </a>
              </li>
            )
          })
        }
      </ul>
    </section>
  </main>

  <footer class="wrap foot">
    <span class="wordmark">familiar</span>
    <p>
      <a href={links.docs}>Docs</a> ·
      <a class="with-icon" href={links.github}
        ><GitBranch size={14} />GitHub</a
      > · MIT licensed · Built on <a href={links.piDurable}>Pi Durable</a>
    </p>
    <p class="demos">
      Try it in your browser:{' '}
      {
        demos.map((demo, index) => (
          <>
            {index > 0 && ' · '}
            <a href={demo.href}>{demo.label}</a>
          </>
        ))
      }
    </p>
  </footer>

  <script>
    // Preselect Windows for Windows visitors; the CSS default works without it.
    if (navigator.userAgent.includes('Windows')) {
      const windows = document.querySelector<HTMLInputElement>(
        'input[name="os-sheet"][value="windows"]',
      )
      if (windows) windows.checked = true
    }
  </script>
</Shell>

<style is:global>
  .sheet-wrap {
    max-width: 78rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  .lucide {
    flex: none;
  }
</style>

<style>
  .wrap {
    max-width: 78rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  /* Header */
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem;
  }

  .wordmark {
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    font-size: 0.875rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  nav .nav-install {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    background: var(--block);
    color: var(--on-block);
    font-weight: 600;
  }

  nav .nav-install:hover {
    color: var(--on-block);
  }

  /* Install panel */
  .install {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .panel {
    border: 1px solid var(--text);
    background: var(--bg);
  }

  .panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border-bottom: 1px solid var(--rule-strong);
  }

  .panel-head h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--text);
    color: var(--bg);
  }

  .tabs {
    display: flex;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .tabs label {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
    border-right: 1px solid var(--rule);
    cursor: pointer;
  }

  .tabs input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tabs label:has(:checked) {
    color: var(--text);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--accent);
  }

  .tabs label:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  .guide {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .guide:hover {
    text-decoration: underline;
  }

  .command {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem) 1.25rem;
    font-size: clamp(0.875rem, 1.4vw, 1.0625rem);
  }

  .prompt {
    color: var(--accent);
    font-weight: 700;
  }

  .command code {
    flex: 1;
    min-width: 0;
    word-break: break-all;
  }

  /* Without :has, both commands stay visible. */
  @supports selector(:has(*)) {
    .panel:has([value='unix']:checked) [data-os='windows'],
    .panel:has([value='windows']:checked) [data-os='unix'] {
      display: none;
    }
  }

  /* Class-qualified so it outranks the shell's element-level button reset
     whatever order the stylesheets load in. */
  .command button {
    flex: none;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    background: var(--block);
    color: var(--on-block);
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }

  .panel-foot {
    padding: 0.875rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
    background: var(--surface);
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 40rem) {
    .panel-head h2 {
      width: 100%;
    }

    .tabs {
      flex: 1;
    }

    .tabs label {
      flex: 1;
      justify-content: center;
      padding-inline: 0.75rem;
    }

    .tabs label:last-child {
      border-right: 0;
    }

    .guide {
      margin-left: 0;
      width: 100%;
      border-top: 1px solid var(--rule);
    }

    .command {
      flex-wrap: wrap;
    }

    .command code {
      flex-basis: calc(100% - 3rem);
    }
  }

  /* Features */
  .features {
    padding-top: clamp(4.5rem, 10vw, 8rem);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--text);
  }

  .section-head h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.75rem 1.5rem 2rem;
    border-top: 1px solid var(--rule-strong);
  }

  .cell-1,
  .cell-2 {
    grid-column: span 3;
    min-height: 17rem;
    padding: 2rem;
  }

  .cell-3,
  .cell-4,
  .cell-5 {
    grid-column: span 2;
  }

  .cell-1 {
    background: var(--block);
    color: var(--on-block);
    border-top-color: var(--block);
  }

  .cell-2 {
    background: var(--surface);
  }

  .cell-4,
  .cell-5 {
    border-left: 1px solid var(--rule);
  }

  .cell-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cell :global(.cell-icon) {
    color: currentColor;
    opacity: 0.65;
  }

  .cell-1 :global(.cell-icon) {
    color: var(--on-block-muted);
    opacity: 1;
  }

  .cell h3 {
    margin-top: 1.5rem;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .cell-1 h3,
  .cell-2 h3 {
    margin-top: auto;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
  }

  .cell p {
    max-width: 30rem;
    color: var(--muted);
  }

  .cell-1 p {
    color: var(--on-block-muted);
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .cell-1,
    .cell-2,
    .cell-3,
    .cell-4 {
      grid-column: span 1;
    }

    .cell-1,
    .cell-2 {
      min-height: 14rem;
    }

    .cell-3 {
      border-left: 0;
    }

    .cell-5 {
      grid-column: 1 / -1;
      border-left: 0;
    }
  }

  @media (max-width: 36rem) {
    .features {
      padding-inline: 0;
    }

    .section-head {
      margin-inline: clamp(1rem, 4vw, 3rem);
    }

    nav {
      width: 100%;
      column-gap: 1rem;
    }

    nav .nav-install {
      margin-left: auto;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .grid .cell {
      grid-column: 1;
      min-height: 0;
      padding: 1.5rem 1.25rem;
      border-left: 0;
    }

    .cell-1 h3,
    .cell-2 h3 {
      margin-top: 1.5rem;
    }
  }

  /* Paths */
  .paths {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .paths ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .paths li {
    border-top: 1px solid var(--text);
  }

  .paths a {
    display: block;
    padding: 1.75rem 0 0.5rem;
    text-decoration: none;
  }

  .path-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: clamp(1.25rem, 2.6vw, 1.875rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .path-line {
    display: block;
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .paths :global(.arrow) {
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    color: inherit;
  }

  .paths a:hover .path-text {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  @media (max-width: 40rem) {
    .paths ul {
      grid-template-columns: 1fr;
    }
  }

  /* Footer */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem 3rem;
    border-top: 1px solid var(--rule-strong);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .foot .wordmark {
    color: var(--text);
  }

  .with-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    vertical-align: bottom;
  }

  .foot .demos {
    margin-left: auto;
  }
</style>
