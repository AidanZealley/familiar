---
import Key from '@phosphor-icons/core/regular/key.svg'
import Stack from '@phosphor-icons/core/regular/stack.svg'
import Monitor from '@phosphor-icons/core/regular/monitor.svg'
import { links } from './links'
---

<dl class="spec">
  <div>
    <dt><Monitor class="icon" aria-hidden="true" width={14} height={14} />Runs on</dt>
    <dd>macOS, Linux and Windows</dd>
  </div>
  <div>
    <dt><Key class="icon" aria-hidden="true" width={14} height={14} />Signs in with</dt>
    <dd>Your ChatGPT subscription</dd>
  </div>
  <div>
    <dt><Stack class="icon" aria-hidden="true" width={14} height={14} />Built on</dt>
    <dd><a href={links.piDurable}>Pi Durable</a></dd>
  </div>
</dl>

<style>
  .spec {
    display: grid;
    gap: 1rem 2rem;
    margin: 0;
    font-size: 0.875rem;
  }

  dt {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dt :global(svg) {
    color: var(--accent);
  }

  dd {
    margin-top: 0.125rem;
    font-weight: 600;
  }
</style>
