---
// Refinement E, "Currents": a stack of faint wave lines on the right of the
// header, each drifting sideways at its own slow pace, one in violet. An
// atmosphere of something carried along, with no picture to decode.
import Hero from '../../landing/sheet/Hero.astro'
import Sheet from '../../landing/sheet/Sheet.astro'

// Each line is a sine across 400 units. Its period divides 200, so sliding the
// line by half its width (200 units) loops seamlessly.
const lines = [
  { period: 200, amp: 10, phase: 0, dur: 70 },
  { period: 100, amp: 5, phase: 1.2, dur: 54 },
  { period: 200, amp: 14, phase: 2.4, dur: 88, accent: true },
  { period: 100, amp: 8, phase: 0.6, dur: 62 },
  { period: 50, amp: 3, phase: 1.8, dur: 46 },
  { period: 200, amp: 12, phase: 3.1, dur: 80 },
  { period: 100, amp: 6, phase: 2.2, dur: 58 },
  { period: 200, amp: 9, phase: 0.9, dur: 74 },
]

const wave = (period: number, amp: number, phase: number) =>
  Array.from({ length: 201 }, (_, i) => {
    const x = i * 2
    const y = 20 + amp * Math.sin((2 * Math.PI * x) / period + phase)
    return `${i === 0 ? 'M' : 'L'}${x} ${y.toFixed(2)}`
  }).join(' ')
---

<Sheet title="Familiar · Landing E" home="/familiar/landing/e/">
  <Hero>
    <div class="currents" slot="art">
      {
        lines.map((line, index) => (
          <svg
            class:list={['wave', { accent: line.accent }]}
            viewBox="0 0 400 40"
            preserveAspectRatio="none"
            style={`--row: ${index}; --dur: ${line.dur}s`}
          >
            <path
              d={wave(line.period, line.amp, line.phase)}
              vector-effect="non-scaling-stroke"
            />
          </svg>
        ))
      }
    </div>
  </Hero>
</Sheet>

<style>
  .currents {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: repeat(8, 1fr);
    align-items: center;
  }

  .wave {
    display: block;
    width: 200%;
    height: 3rem;
    overflow: visible;
  }

  .wave path {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1.25;
  }

  .wave.accent path {
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wave {
      animation: drift var(--dur) linear infinite;
      animation-delay: calc(var(--row) * -7s);
    }
  }

  @keyframes drift {
    to {
      translate: -50% 0;
    }
  }

  @media (max-width: 56rem) {
    .currents {
      grid-template-rows: repeat(8, 1fr);
    }

    .wave {
      height: 1.5rem;
    }
  }
</style>
