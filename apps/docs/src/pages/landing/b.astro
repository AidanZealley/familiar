---
// Variant B, "Bands": full-width horizontal bands. A violet headline band,
// an install console that overlaps its lower edge, then the five highlights
// as a tonal ramp of columns stepping from Mist into violet. Motion: the
// install switch, whose indicator slides and whose command settles in.
import Shell from '../../landing/Shell.astro'
import {
  demosStub,
  headline,
  highlights,
  installers,
  links,
  paths,
  pitch,
  signIn,
} from '../../landing/content'
---

<Shell title="Familiar · Landing B">
  <header class="bar">
    <div class="wrap bar-inner">
      <a class="wordmark" href="/familiar/landing/b/">familiar</a>
      <nav aria-label="Primary">
        <a href={links.docs}>Docs</a>
        <a href={links.build}>Build</a>
        <a href={links.github}>GitHub</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="wrap">
        <p class="kicker">For macOS, Linux and Windows</p>
        <h1>{headline}</h1>
        <p class="pitch">{pitch}</p>
      </div>
    </section>

    <section class="wrap install-wrap" aria-labelledby="install">
      <div class="console">
        <div class="console-head">
          <h2 id="install">Install in one line</h2>
          <fieldset class="seg">
            <legend class="sr-only">Operating system</legend>
            {
              installers.map((installer, index) => (
                <label>
                  <input
                    type="radio"
                    name="os-b"
                    value={installer.id}
                    checked={index === 0}
                  />
                  {installer.short}
                </label>
              ))
            }
          </fieldset>
        </div>
        <div class="commands">
          {
            installers.map((installer) => (
              <div class="command" data-os={installer.id}>
                <span class="sr-only">{installer.os}:</span>
                <code>{installer.command}</code>
                <button type="button" data-copy={installer.command} hidden>
                  Copy
                </button>
              </div>
            ))
          }
        </div>
        <p class="note">
          {signIn}{' '}
          <a href={links.install}>Install guide</a>
        </p>
      </div>
    </section>

    <section class="ramp" aria-labelledby="what">
      <h2 id="what" class="sr-only">What it does</h2>
      <ol>
        {
          highlights.map((highlight, index) => (
            <li class={`step step-${index + 1}`}>
              <span class="num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{highlight.label}</h3>
              <p>{highlight.line}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="links" aria-labelledby="next">
      <div class="wrap">
        <h2 id="next" class="sr-only">Read on</h2>
        <ul>
          {
            paths.map((path) => (
              <li>
                <a href={path.href}>
                  <span class="link-label">{path.label}</span>
                  <span class="link-line">{path.line}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={links.github}>
              <span class="link-label">Source on GitHub</span>
              <span class="link-line">MIT licensed. Issues and releases.</span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <p>Built on <a href={links.piDurable}>Pi Durable</a>.</p>
      <p>{demosStub}</p>
    </div>
  </footer>

  <script>
    // Preselect Windows for Windows visitors; the CSS default works without it.
    if (navigator.userAgent.includes('Windows')) {
      const windows = document.querySelector<HTMLInputElement>(
        'input[name="os-b"][value="windows"]',
      )
      if (windows) windows.checked = true
    }
  </script>
</Shell>

<style>
  .wrap {
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  /* Bar */
  .bar {
    background: var(--block);
    color: var(--on-block);
  }

  .bar :focus-visible,
  .hero :focus-visible {
    outline-color: var(--on-block);
  }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--on-block-rule);
  }

  .wordmark {
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.875rem;
  }

  nav a {
    color: var(--on-block-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--on-block);
  }

  /* Hero band, with room at the bottom for the console to overlap. */
  .hero {
    background: var(--block);
    color: var(--on-block);
    padding-block: clamp(3rem, 8vw, 6rem) clamp(7rem, 12vw, 9rem);
  }

  .kicker {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-block-muted);
  }

  h1 {
    max-width: 22ch;
    margin-top: 1.25rem;
    font-size: clamp(2.25rem, 6vw, 5rem);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .pitch {
    max-width: 40rem;
    margin-top: 1.75rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--on-block-muted);
  }

  /* Install console */
  .install-wrap {
    margin-top: clamp(-6rem, -9vw, -4.5rem);
  }

  .console {
    max-width: 58rem;
    background: var(--bg);
    border: 1px solid var(--rule-strong);
  }

  .console-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.25rem clamp(1rem, 3vw, 1.75rem);
    border-bottom: 1px solid var(--rule);
  }

  .console-head h2 {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  /* Segmented switch with a sliding indicator. */
  .seg {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 0.25rem;
    border: 0;
    background: var(--surface-2);
  }

  .seg::before {
    content: '';
    position: absolute;
    inset: 0.25rem auto 0.25rem 0.25rem;
    width: calc(50% - 0.25rem);
    background: var(--block);
    transition: translate 320ms cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .seg:has([value='windows']:checked)::before {
    translate: 100% 0;
  }

  .seg label {
    position: relative;
    padding: 0.375rem 1rem;
    font-size: 0.8125rem;
    text-align: center;
    white-space: nowrap;
    cursor: pointer;
    transition: color 200ms;
  }

  .seg label:has(:checked) {
    color: var(--on-block);
    font-weight: 700;
  }

  .seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .seg label:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .commands {
    padding: clamp(1.5rem, 4vw, 2.25rem) clamp(1rem, 3vw, 1.75rem);
  }

  .command {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: clamp(0.875rem, 1.5vw, 1.0625rem);
  }

  .command code {
    flex: 1;
    min-width: 0;
    word-break: break-all;
  }

  .command code::before {
    content: '› ';
    color: var(--accent);
    font-weight: 700;
  }

  /* Without :has, both commands stay visible. */
  @supports selector(:has(*)) {
    .console:has([value='unix']:checked) [data-os='windows'],
    .console:has([value='windows']:checked) [data-os='unix'] {
      display: none;
    }
  }

  /* A command settles in each time it is shown. */
  @media (prefers-reduced-motion: no-preference) {
    .command {
      animation: settle 380ms cubic-bezier(0.3, 0.7, 0.2, 1);
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seg::before,
    .seg label {
      transition: none;
    }
  }

  button {
    flex: none;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    background: var(--text);
    color: var(--bg);
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }

  .note {
    padding: 1rem clamp(1rem, 3vw, 1.75rem);
    font-size: 0.8125rem;
    color: var(--muted);
    background: var(--surface);
  }

  .note a {
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 36rem) {
    .command {
      flex-wrap: wrap;
      gap: 1rem;
    }

    .command code {
      flex-basis: 100%;
    }
  }

  /* Highlights: five columns stepping from the page tone into violet. */
  .ramp {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .ramp ol {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 24rem;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border-top: 1px solid var(--rule);
  }

  .step-1 {
    background: var(--bg);
  }
  .step-2 {
    background: var(--surface);
  }
  .step-3 {
    background: var(--surface-2);
  }
  .step-4 {
    background: var(--surface-3);
  }
  .step-5 {
    background: var(--block);
    color: var(--on-block);
  }

  .num {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent);
  }

  .step h3 {
    margin-top: auto;
    font-size: clamp(1.375rem, 2.2vw, 1.875rem);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .step p {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .step-4 p {
    color: var(--text);
  }

  .step-5 .num,
  .step-5 p {
    color: var(--on-block-muted);
  }

  @media (max-width: 64rem) {
    .ramp ol {
      grid-template-columns: 1fr;
    }

    .step {
      display: grid;
      grid-template-columns: 3rem minmax(9rem, 14rem) 1fr;
      align-items: baseline;
      gap: 0.25rem 1.5rem;
      min-height: 0;
      padding-block: 1.75rem;
      padding-inline: max(clamp(1rem, 4vw, 2.5rem), (100% - 76rem) / 2 + 2.5rem);
    }

    .step h3 {
      margin-top: 0;
    }
  }

  @media (max-width: 40rem) {
    .step {
      grid-template-columns: 2.5rem 1fr;
    }

    .step p {
      grid-column: 2;
    }
  }

  /* Links */
  .links ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 0;
    list-style: none;
  }

  .links li + li {
    border-left: 1px solid var(--rule);
  }

  .links a {
    display: grid;
    gap: 0.375rem;
    height: 100%;
    padding: 2.25rem 1.5rem 2.25rem 0;
    text-decoration: none;
  }

  .links li + li a {
    padding-left: 1.5rem;
  }

  .link-label {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .link-label::after {
    content: ' →';
    color: var(--accent);
  }

  .link-line {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .links a:hover .link-label {
    text-decoration: underline;
  }

  @media (max-width: 52rem) {
    .links ul {
      grid-template-columns: 1fr;
    }

    .links li + li {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .links a,
    .links li + li a {
      padding: 1.5rem 0;
    }
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 3rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
