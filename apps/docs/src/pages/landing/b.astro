---
// Variant B, "Bands": full-width horizontal bands stacked like a poster. A
// violet block carries the name at display size; the five highlights read
// across one ruled row. Motion: a slow wave of font weight through the name.
// Monospace keeps every weight the same width, so nothing reflows.
import Shell from '../../landing/Shell.astro'
import {
  demosStub,
  headline,
  highlights,
  installers,
  links,
  pitch,
  signIn,
} from '../../landing/content'

const name = [...'Familiar']
---

<Shell title="Familiar · Landing B">
  <header class="bar">
    <div class="wrap bar-inner">
      <a class="home" href="/familiar/landing/b/">familiar</a>
      <nav aria-label="Primary">
        <a href={links.docs}>Docs</a>
        <a href={links.build}>Build</a>
        <a href={links.github}>GitHub</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="name">
      <div class="wrap">
        <h1 id="name">
          <span class="sr-only">Familiar</span>
          <span class="wave" aria-hidden="true">
            {name.map((letter, i) => <span style={`--i: ${i}`}>{letter}</span>)}
          </span>
        </h1>
        <div class="intro">
          <p class="headline">{headline}</p>
          <p class="pitch">{pitch}</p>
        </div>
      </div>
    </section>

    <section class="install" aria-labelledby="install">
      <div class="wrap install-inner">
        <h2 id="install" class="label">Install</h2>
        <fieldset class="os">
          <legend class="sr-only">Operating system</legend>
          {
            installers.map((installer, index) => (
              <label>
                <input
                  type="radio"
                  name="os"
                  value={installer.id}
                  checked={index === 0}
                />
                {installer.os}
              </label>
            ))
          }
        </fieldset>
        <div class="commands">
          {
            installers.map((installer) => (
              <div class="command" data-os={installer.id}>
                <span class="sr-only">{installer.os}:</span>
                <code>{installer.command}</code>
                <button type="button" data-copy={installer.command} hidden>
                  Copy
                </button>
              </div>
            ))
          }
        </div>
        <p class="note">
          {signIn} <a href={links.install}>Install guide</a>
        </p>
      </div>
    </section>

    <section class="row" aria-labelledby="what">
      <div class="wrap">
        <h2 id="what" class="sr-only">What it does</h2>
        <ol class="highlights">
          {
            highlights.map((highlight) => (
              <li>
                <h3>{highlight.label}</h3>
                <p>{highlight.line}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="links" aria-labelledby="next">
      <div class="wrap">
        <h2 id="next" class="sr-only">Read on</h2>
        <ul>
          <li><a href={links.docs}>Docs</a></li>
          <li><a href={links.build}>Build guide</a></li>
          <li><a href={links.github}>GitHub</a></li>
        </ul>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <p>Built on <a href={links.piDurable}>Pi Durable</a>. MIT licensed.</p>
      <p>{demosStub}</p>
    </div>
  </footer>

  <script>
    // Preselect Windows for Windows visitors. Without this, the CSS default
    // still shows a working command.
    if (navigator.userAgent.includes('Windows')) {
      const windows = document.querySelector<HTMLInputElement>(
        'input[name="os"][value="windows"]',
      )
      if (windows) windows.checked = true
    }
  </script>
</Shell>

<style>
  .wrap {
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Bar */
  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }

  .home {
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.875rem;
  }

  nav a {
    text-decoration: none;
    color: var(--muted);
  }

  nav a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  /* Hero band */
  .hero {
    background: var(--block);
    color: var(--on-block);
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2.5rem, 6vw, 4rem);
  }

  .hero :focus-visible {
    outline-color: var(--on-block);
  }

  h1 {
    font-size: clamp(3.25rem, 15.5vw, 11.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-weight: 700;
    white-space: nowrap;
  }

  .wave span {
    font-weight: 700;
    animation: wave 7s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.35s - 7s);
  }

  @keyframes wave {
    0%,
    100% {
      font-weight: 700;
    }
    35% {
      font-weight: 250;
    }
    60% {
      font-weight: 800;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave span {
      animation: none;
    }
  }

  .intro {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--on-block-rule);
  }

  .headline {
    font-size: clamp(1.125rem, 2.4vw, 1.5rem);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .pitch {
    color: var(--on-block-muted);
  }

  /* Install band */
  .install {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
  }

  .install-inner {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: 1.5rem;
  }

  .install .label {
    color: var(--muted);
  }

  .os {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule-strong);
  }

  .os label {
    position: relative;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .os label + label {
    border-left: 1px solid var(--rule-strong);
  }

  .os input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .os label:has(:checked) {
    background: var(--text);
    color: var(--bg);
  }

  .os label:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .commands {
    min-width: 0;
  }

  .command {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .command code {
    flex: 1;
    min-width: 0;
    font-size: 0.8125rem;
    word-break: break-all;
  }

  /* Without :has, both commands stay visible. */
  @supports selector(:has(*)) {
    .install-inner:has([value='unix']:checked) [data-os='windows'],
    .install-inner:has([value='windows']:checked) [data-os='unix'] {
      display: none;
    }
  }

  button {
    flex: none;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    background: var(--bg);
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    cursor: pointer;
  }

  button:hover {
    border-color: var(--text);
  }

  .note {
    grid-column: 1 / -1;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .note a {
    color: var(--text);
  }

  @media (max-width: 52rem) {
    .install-inner {
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }

    .os {
      justify-self: start;
    }
  }

  /* Highlights row */
  .row {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--rule);
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 0;
    list-style: none;
  }

  .highlights li {
    padding: 0 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .highlights li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .highlights h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .highlights h3::before {
    content: '';
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    margin-bottom: 1rem;
    background: var(--accent);
  }

  .highlights p {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 64rem) {
    .highlights {
      grid-template-columns: 1fr;
    }

    .highlights li,
    .highlights li:first-child {
      display: grid;
      grid-template-columns: 11rem 1fr;
      gap: 0.25rem 1.5rem;
      align-items: baseline;
      padding: 1rem 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .highlights li:first-child {
      border-top: 0;
      padding-top: 0;
    }

    .highlights h3::before {
      display: inline-block;
      width: 0.5rem;
      height: 0.5rem;
      margin: 0 0.75rem 0.1em 0;
    }

    .highlights p {
      margin-top: 0;
    }
  }

  @media (max-width: 36rem) {
    .highlights li,
    .highlights li:first-child {
      grid-template-columns: 1fr;
    }
  }

  /* Links band */
  .links ul {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    list-style: none;
  }

  .links li {
    flex: 1 1 12rem;
    border-bottom: 1px solid var(--rule);
  }

  .links a {
    display: flex;
    justify-content: space-between;
    padding-block: 1.25rem;
    padding-right: 1.5rem;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .links a::after {
    content: '→';
    color: var(--accent);
  }

  .links a:hover {
    text-decoration: underline;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 3rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
