---
// Comparison index for the landing prototypes. Not linked from the docs.
import Shell from '../../landing/Shell.astro'

const variants = [
  {
    letter: 'A',
    name: 'Sheet',
    href: '/familiar/landing/a/',
    summary:
      'An editorial grid: a large headline with a spec column, a tabbed install panel, and the highlights as a weighted grid led by two large cells.',
    motion: 'Section rules draw across as they scroll into view.',
  },
  {
    letter: 'B',
    name: 'Bands',
    href: '/familiar/landing/b/',
    summary:
      'Full-width bands: a violet headline band, an install console overlapping its edge, and the highlights as a tonal ramp from Mist into violet.',
    motion:
      'The install switch: its indicator slides and the chosen command settles in.',
  },
  {
    letter: 'C',
    name: 'Poster',
    href: '/familiar/landing/c/',
    summary:
      'Big type: a centred opening, a full-bleed violet install slab, and the highlights as display-size names alternating sides.',
    motion: 'The violet install slab opens out to the page edges on scroll.',
  },
]
---

<Shell title="Familiar · Landing variants">
  <main id="main" class="page">
    <h1>Landing variants</h1>
    <p class="lede">
      Three prototypes for Familiar's landing page, second round. The docs homepage is
      unchanged.
    </p>
    <ol>
      {
        variants.map((variant) => (
          <li>
            <a href={variant.href}>
              <span class="letter">{variant.letter}</span>
              <span class="name">{variant.name}</span>
            </a>
            <p>{variant.summary}</p>
            <p class="motion">Motion: {variant.motion}</p>
          </li>
        ))
      }
    </ol>
  </main>
</Shell>

<style>
  .page {
    max-width: 44rem;
    margin-inline: auto;
    padding: 3rem 1rem 4rem;
  }

  h1 {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .lede {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  ol {
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--text);
  }

  li {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  li a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .letter {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    background: var(--block);
    color: var(--on-block);
    font-size: 0.9375rem;
  }

  li p {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .motion {
    font-size: 0.8125rem;
  }
</style>
