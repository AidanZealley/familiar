---
// Comparison index for the landing prototypes. Not linked from the docs.
import Shell from '../../landing/Shell.astro'

const current = [
  {
    letter: 'A',
    name: 'Baseline',
    href: '/familiar/landing/a/',
    summary:
      'The chosen direction, unchanged: editorial grid, spec column, tabbed install panel and weighted highlight grid.',
    motion: 'Section rules draw across as they scroll into view.',
  },
  {
    letter: 'D',
    name: 'Margins',
    href: '/familiar/landing/d/',
    summary:
      'A with an annotated headline: three phrases highlighted and footnoted, glossed by margin notes with icons. Lucide icons through the page.',
    motion: 'The highlighter sweeps across each phrase once, in reading order.',
  },
  {
    letter: 'E',
    name: 'Thread',
    href: '/familiar/landing/e/',
    summary:
      'A with a week strip under the headline: one unbroken line through every day, with stops for devices, a night, a tool and home. Lucide icons through the page.',
    motion: 'The line draws across once and each stop appears as it arrives.',
  },
  {
    letter: 'F',
    name: 'Horizon',
    href: '/familiar/landing/f/',
    summary:
      'A beside a flat violet day-and-night scene: home and devices on the horizon, sun and moon on one arc. Lucide icons through the page.',
    motion: 'Scrolling turns the arc: the sun sets and the moon rises.',
  },
]

const earlier = [
  { letter: 'B', name: 'Bands', href: '/familiar/landing/b/' },
  { letter: 'C', name: 'Poster', href: '/familiar/landing/c/' },
]
---

<Shell title="Familiar · Landing variants">
  <main id="main" class="page">
    <h1>Landing variants</h1>
    <p class="lede">
      Baseline A and three refinements of it. The docs homepage is unchanged.
    </p>
    <ol>
      {
        current.map((variant) => (
          <li>
            <a href={variant.href}>
              <span class="letter">{variant.letter}</span>
              <span class="name">{variant.name}</span>
            </a>
            <p>{variant.summary}</p>
            <p class="motion">Motion: {variant.motion}</p>
          </li>
        ))
      }
    </ol>
    <p class="earlier">
      Earlier round:
      {
        earlier.map((variant) => (
          <a href={variant.href}>
            {variant.letter} · {variant.name}
          </a>
        ))
      }
    </p>
  </main>
</Shell>

<style>
  .page {
    max-width: 44rem;
    margin-inline: auto;
    padding: 3rem 1rem 4rem;
  }

  h1 {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .lede {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  ol {
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--text);
  }

  li {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  li a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .letter {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    background: var(--block);
    color: var(--on-block);
    font-size: 0.9375rem;
  }

  li p {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .motion {
    font-size: 0.8125rem;
  }

  .earlier {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 2rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .earlier a {
    color: var(--text);
  }
</style>
