---
// Variant A, "Sheet": an editorial grid. A large headline with a short spec
// column, a tabbed install panel, and the five highlights as a weighted grid
// where the first two lead. Motion: section rules draw across as they scroll
// into view (scroll-driven CSS; static full rules otherwise).
import Shell from '../../landing/Shell.astro'
import {
  demosStub,
  headline,
  highlights,
  installers,
  links,
  paths,
  pitch,
  signIn,
} from '../../landing/content'
---

<Shell title="Familiar · Landing A">
  <header class="wrap top">
    <a class="wordmark" href="/familiar/landing/a/">familiar</a>
    <nav aria-label="Primary">
      <a href={links.docs}>Docs</a>
      <a href={links.build}>Build</a>
      <a href={links.github}>GitHub</a>
      <a class="nav-install" href="#install">Install</a>
    </nav>
  </header>

  <main id="main">
    <section class="wrap hero">
      <h1>{headline}</h1>
      <p class="lede">{pitch}</p>
      <dl class="spec">
        <div>
          <dt>Runs on</dt>
          <dd>macOS, Linux and Windows</dd>
        </div>
        <div>
          <dt>Signs in with</dt>
          <dd>Your ChatGPT subscription</dd>
        </div>
        <div>
          <dt>Built on</dt>
          <dd><a href={links.piDurable}>Pi Durable</a></dd>
        </div>
      </dl>
    </section>

    <section class="wrap install" id="install" aria-labelledby="install-title">
      <div class="panel">
        <div class="panel-head">
          <h2 id="install-title">Install</h2>
          <fieldset class="tabs">
            <legend class="sr-only">Operating system</legend>
            {
              installers.map((installer, index) => (
                <label>
                  <input
                    type="radio"
                    name="os-a"
                    value={installer.id}
                    checked={index === 0}
                  />
                  {installer.short}
                </label>
              ))
            }
          </fieldset>
          <a class="guide" href={links.install}>Install guide →</a>
        </div>
        {
          installers.map((installer) => (
            <div class="command" data-os={installer.id}>
              <span class="sr-only">{installer.os}:</span>
              <span class="prompt" aria-hidden="true">
                {installer.prompt}
              </span>
              <code>{installer.command}</code>
              <button type="button" data-copy={installer.command} hidden>
                Copy
              </button>
            </div>
          ))
        }
        <p class="panel-foot">{signIn}</p>
      </div>
    </section>

    <section class="wrap features" aria-labelledby="features-title">
      <div class="section-head rule">
        <h2 id="features-title">What you get</h2>
        <p>Five things it does differently.</p>
      </div>
      <ol class="grid">
        {
          highlights.map((highlight, index) => (
            <li class={`cell rule cell-${index + 1}`}>
              <span class="num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{highlight.label}</h3>
              <p>{highlight.line}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="wrap paths" aria-labelledby="paths-title">
      <h2 id="paths-title" class="sr-only">Where to next</h2>
      <ul>
        {
          paths.map((path) => (
            <li class="rule">
              <a href={path.href}>
                <span class="path-label">{path.label}</span>
                <span class="path-line">{path.line}</span>
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="wrap foot rule">
    <span class="wordmark">familiar</span>
    <p>
      <a href={links.docs}>Docs</a> · <a href={links.github}>GitHub</a> · MIT
      licensed · Built on <a href={links.piDurable}>Pi Durable</a>
    </p>
    <p class="soon">{demosStub}</p>
  </footer>

  <script>
    // Preselect Windows for Windows visitors; the CSS default works without it.
    if (navigator.userAgent.includes('Windows')) {
      const windows = document.querySelector<HTMLInputElement>(
        'input[name="os-a"][value="windows"]',
      )
      if (windows) windows.checked = true
    }
  </script>
</Shell>

<style>
  .wrap {
    max-width: 78rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  /* Header */
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem;
  }

  .wordmark {
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    font-size: 0.875rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  nav .nav-install {
    padding: 0.375rem 0.875rem;
    background: var(--block);
    color: var(--on-block);
    font-weight: 600;
  }

  nav .nav-install:hover {
    color: var(--on-block);
  }

  /* Hero: headline across nine columns, spec column at the side. */
  .hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 1.5rem;
    padding-block: clamp(3rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  h1 {
    grid-column: 1 / span 9;
    font-size: clamp(2.125rem, 5.6vw, 4.75rem);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .lede {
    grid-column: 1 / span 6;
    margin-top: 2rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--muted);
    text-wrap: pretty;
  }

  .spec {
    grid-column: 9 / span 4;
    align-self: end;
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
    font-size: 0.875rem;
  }

  .spec dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .spec dd {
    font-weight: 600;
  }

  @media (max-width: 56rem) {
    h1,
    .lede,
    .spec {
      grid-column: 1 / -1;
    }

    .spec {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }

  /* Install panel */
  .panel {
    border: 1px solid var(--text);
    background: var(--bg);
  }

  .panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border-bottom: 1px solid var(--rule-strong);
  }

  .panel-head h2 {
    display: flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--text);
    color: var(--bg);
  }

  .tabs {
    display: flex;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .tabs label {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
    border-right: 1px solid var(--rule);
    cursor: pointer;
  }

  .tabs input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tabs label:has(:checked) {
    color: var(--text);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--accent);
  }

  .tabs label:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  .guide {
    margin-left: auto;
    display: flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .guide:hover {
    text-decoration: underline;
  }

  .command {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem) 1.25rem;
    font-size: clamp(0.875rem, 1.4vw, 1.0625rem);
  }

  .prompt {
    color: var(--accent);
    font-weight: 700;
  }

  .command code {
    flex: 1;
    min-width: 0;
    word-break: break-all;
  }

  /* Without :has, both commands stay visible. */
  @supports selector(:has(*)) {
    .panel:has([value='unix']:checked) [data-os='windows'],
    .panel:has([value='windows']:checked) [data-os='unix'] {
      display: none;
    }
  }

  button {
    flex: none;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    background: var(--block);
    color: var(--on-block);
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }

  .panel-foot {
    padding: 0.875rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
    background: var(--surface);
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 40rem) {
    .panel-head h2 {
      width: 100%;
    }

    .tabs {
      flex: 1;
    }

    .tabs label {
      flex: 1;
      justify-content: center;
      padding-inline: 0.75rem;
    }

    .tabs label:last-child {
      border-right: 0;
    }

    .guide {
      margin-left: 0;
      width: 100%;
      border-top: 1px solid var(--rule);
    }

    .command {
      flex-wrap: wrap;
    }

    .command code {
      flex-basis: calc(100% - 3rem);
    }
  }

  /* Rules that draw across. Every .rule gets a top line from ::before. */
  .rule {
    position: relative;
  }

  .rule::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--text);
    transform-origin: left;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rule::before {
        animation-name: draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 90%;
      }
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Features */
  .features {
    padding-top: clamp(4.5rem, 10vw, 8rem);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.25rem;
  }

  .section-head h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .section-head p {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.75rem 1.5rem 2rem;
  }

  .cell::before {
    background: var(--rule-strong);
  }

  .cell-1,
  .cell-2 {
    grid-column: span 3;
    min-height: 17rem;
    padding: 2rem;
  }

  .cell-3,
  .cell-4,
  .cell-5 {
    grid-column: span 2;
  }

  .cell-1 {
    background: var(--block);
    color: var(--on-block);
  }

  .cell-1::before {
    background: var(--text);
  }

  .cell-2 {
    background: var(--surface);
  }

  .cell-4,
  .cell-5 {
    border-left: 1px solid var(--rule);
  }

  .num {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent);
  }

  .cell-1 .num {
    color: var(--on-block-muted);
  }

  .cell h3 {
    margin-top: 1.5rem;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .cell-1 h3,
  .cell-2 h3 {
    margin-top: auto;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
  }

  .cell p {
    max-width: 30rem;
    color: var(--muted);
  }

  .cell-1 p {
    color: var(--on-block-muted);
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .cell-1,
    .cell-2,
    .cell-3,
    .cell-4 {
      grid-column: span 1;
    }

    .cell-1,
    .cell-2 {
      min-height: 14rem;
    }

    .cell-3 {
      border-left: 0;
    }

    .cell-5 {
      grid-column: 1 / -1;
      border-left: 0;
    }
  }

  @media (max-width: 36rem) {
    .grid {
      grid-template-columns: 1fr;
    }

    .grid .cell {
      grid-column: 1;
      min-height: 0;
      padding: 1.5rem 1.25rem;
      border-left: 0;
    }

    .cell-1 h3,
    .cell-2 h3 {
      margin-top: 1.5rem;
    }
  }

  /* Paths */
  .paths {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .paths ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .paths a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1rem;
    padding: 1.75rem 0 0.5rem;
    text-decoration: none;
  }

  .path-label {
    font-size: clamp(1.25rem, 2.6vw, 1.875rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .path-line {
    grid-row: 2;
    color: var(--muted);
  }

  .arrow {
    grid-row: 1 / span 2;
    align-self: center;
    font-size: 1.75rem;
    color: var(--accent);
  }

  .paths a:hover .path-label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  @media (max-width: 40rem) {
    .paths ul {
      grid-template-columns: 1fr;
    }
  }

  /* Footer */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem 3rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .foot::before {
    left: clamp(1rem, 4vw, 3rem);
    right: clamp(1rem, 4vw, 3rem);
    background: var(--rule-strong);
  }

  .foot .wordmark {
    color: var(--text);
  }

  .foot .soon {
    margin-left: auto;
  }
</style>
