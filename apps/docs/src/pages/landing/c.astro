---
// Variant C, "Poster": big type, centred opening, then a full-bleed violet
// install slab and the five highlights as display-size names that alternate
// sides. Motion: the violet slab opens out to the page edges as it scrolls
// into view (scroll-driven clip-path; it is simply full-bleed otherwise).
import Shell from '../../landing/Shell.astro'
import {
  demosStub,
  headline,
  highlights,
  installers,
  links,
  paths,
  pitch,
  signIn,
} from '../../landing/content'
---

<Shell title="Familiar · Landing C">
  <header class="wrap top">
    <a class="wordmark" href="/familiar/landing/c/">familiar</a>
    <nav aria-label="Primary">
      <a href={links.docs}>Docs</a>
      <a href={links.build}>Build</a>
      <a href={links.github}>GitHub</a>
    </nav>
  </header>

  <main id="main">
    <section class="wrap hero">
      <h1>{headline}</h1>
      <p class="lede">{pitch}</p>
      <p class="actions">
        <a class="primary" href="#install">Install Familiar</a>
        <a class="secondary" href={links.docs}>Read the docs</a>
      </p>
    </section>

    <section class="slab" id="install" aria-labelledby="install-title">
      <div class="slab-inner">
        <h2 id="install-title">One line to install.</h2>
        <div class="script">
          {
            installers.map((installer) => (
              <div class="line">
                <p class="comment"># {installer.os}</p>
                <div class="run">
                  <code>{installer.command}</code>
                  <button type="button" data-copy={installer.command} hidden>
                    Copy
                  </button>
                </div>
              </div>
            ))
          }
        </div>
        <p class="note">
          {signIn}{' '}
          <a href={links.install}>Install guide</a>
        </p>
      </div>
    </section>

    <section class="wrap names" aria-labelledby="what">
      <h2 id="what" class="sr-only">What it does</h2>
      <ol>
        {
          highlights.map((highlight, index) => (
            <li>
              <h3>
                <span class="num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                {highlight.label}
              </h3>
              <p>{highlight.line}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="paths" aria-labelledby="paths-title">
      <div class="wrap">
        <h2 id="paths-title" class="sr-only">Where to next</h2>
        <ul>
          {
            paths.map((path) => (
              <li>
                <a href={path.href}>{path.label}</a>
                <p>{path.line}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <footer class="wrap foot">
    <p>
      Built on <a href={links.piDurable}>Pi Durable</a> · <a href={links.github}
        >GitHub</a
      > · MIT licensed
    </p>
    <p>{demosStub}</p>
  </footer>
</Shell>

<style>
  .wrap {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem;
  }

  .wordmark {
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.5rem;
    font-size: 0.875rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  /* Opening: centred display type. */
  .hero {
    padding-block: clamp(3.5rem, 11vw, 8.5rem) clamp(4rem, 10vw, 7.5rem);
    text-align: center;
  }

  h1 {
    max-width: 20ch;
    margin-inline: auto;
    font-size: clamp(2.25rem, 7vw, 6rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .lede {
    max-width: 36rem;
    margin: 2rem auto 0;
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    color: var(--muted);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .actions a {
    padding: 0.75rem 1.375rem;
    font-weight: 700;
    text-decoration: none;
  }

  .primary {
    background: var(--block);
    color: var(--on-block);
  }

  .secondary {
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  .secondary:hover {
    box-shadow: inset 0 0 0 1px var(--text);
  }

  /* Install slab: full-bleed violet. */
  .slab {
    background: var(--block);
    color: var(--on-block);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .slab {
        animation-name: open;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
    }
  }

  @keyframes open {
    from {
      clip-path: inset(0 clamp(0.75rem, 5vw, 6rem));
    }
    to {
      clip-path: inset(0 0);
    }
  }

  .slab :focus-visible {
    outline-color: var(--on-block);
  }

  .slab-inner {
    max-width: 56rem;
    margin-inline: auto;
    padding: clamp(3.5rem, 9vw, 6.5rem) max(1.5rem, min(8vw, 3rem));
  }

  .slab h2 {
    font-size: clamp(1.75rem, 4.5vw, 3.25rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.045em;
    text-align: center;
  }

  .script {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--on-block-rule);
  }

  .line {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--on-block-rule);
  }

  .comment {
    font-size: 0.8125rem;
    color: var(--on-block-muted);
  }

  .run {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-top: 0.375rem;
    font-size: clamp(0.875rem, 1.4vw, 1rem);
  }

  .run code {
    flex: 1;
    min-width: 0;
    word-break: break-all;
  }

  button {
    flex: none;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 700;
    background: var(--on-block);
    color: var(--block);
    border: 0;
    border-radius: 0;
    cursor: pointer;
  }

  .note {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--on-block-muted);
    text-align: center;
  }

  .note a {
    color: var(--on-block);
    font-weight: 700;
  }

  /* Names: display-size labels alternating sides. */
  .names {
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .names ol {
    padding: 0;
    list-style: none;
  }

  .names li {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: end;
    column-gap: 1.5rem;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--rule);
  }

  .names li:first-child {
    border-top: 1px solid var(--text);
  }

  .names h3 {
    grid-column: 1 / span 8;
    font-size: clamp(2.25rem, 7.5vw, 6.5rem);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.055em;
  }

  .names p {
    grid-column: 9 / span 4;
    max-width: 22rem;
    padding-bottom: 0.375rem;
    color: var(--muted);
  }

  .names li:nth-child(even) h3 {
    grid-column: 5 / span 8;
    grid-row: 1;
    text-align: right;
  }

  .names li:nth-child(even) p {
    grid-column: 1 / span 4;
    grid-row: 1;
  }

  .num {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--accent);
  }

  @media (max-width: 48rem) {
    .names li,
    .names li:nth-child(even) {
      grid-template-columns: 1fr;
      row-gap: 0.75rem;
    }

    .names h3,
    .names p,
    .names li:nth-child(even) h3,
    .names li:nth-child(even) p {
      grid-column: 1;
      grid-row: auto;
      text-align: left;
    }
  }

  /* Paths */
  .paths {
    background: var(--surface);
  }

  .paths ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0;
    list-style: none;
  }

  .paths li {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .paths li + li {
    padding-left: clamp(1.5rem, 4vw, 3rem);
    border-left: 1px solid var(--rule-strong);
  }

  .paths a {
    font-size: clamp(1.375rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .paths a::after {
    content: ' →';
    color: var(--accent);
  }

  .paths a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .paths p {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .paths ul {
      grid-template-columns: 1fr;
    }

    .paths li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--rule-strong);
    }
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.75rem 3rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
