---
// Variant C, "Axis": everything on one centred axis with wide vertical
// spacing, the install set in a violet block and the highlights as a quiet
// stack of names. Motion: two squares drifting into alignment and apart.
import Shell from '../../landing/Shell.astro'
import {
  demosStub,
  headline,
  highlights,
  installers,
  links,
  pitch,
  signIn,
} from '../../landing/content'
---

<Shell title="Familiar · Landing C">
  <div class="page">
    <header class="top">
      <a class="brand" href="/familiar/landing/c/">
        <span class="mark" aria-hidden="true">
          <span class="outline"></span>
          <span class="solid"></span>
        </span>
        <span class="word">Familiar</span>
      </a>
      <nav aria-label="Primary">
        <a href={links.docs}>Docs</a>
        <span aria-hidden="true">/</span>
        <a href={links.build}>Build</a>
        <span aria-hidden="true">/</span>
        <a href={links.github}>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="intro">
        <h1>{headline}</h1>
        <p class="lede">{pitch}</p>
      </section>

      <section class="install" aria-labelledby="install">
        <h2 id="install" class="sr-only">Install</h2>
        <div class="script">
          {
            installers.map((installer) => (
              <div class="line">
                <p class="comment"># {installer.os}</p>
                <div class="run">
                  <code>{installer.command}</code>
                  <button type="button" data-copy={installer.command} hidden>
                    Copy
                  </button>
                </div>
              </div>
            ))
          }
        </div>
        <p class="note">
          {signIn}<br /><a href={links.install}>Read the install guide</a>
        </p>
      </section>

      <section class="what" aria-labelledby="what">
        <h2 id="what" class="sr-only">What it does</h2>
        <ul class="names">
          {
            highlights.map((highlight) => (
              <li>
                <h3>{highlight.label}</h3>
                <p>{highlight.line}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="next" aria-labelledby="next">
        <h2 id="next" class="sr-only">Read on</h2>
        <p class="go">
          <a href={links.docs}>Docs</a>
          <a href={links.build}>Build guide</a>
          <a href={links.github}>GitHub</a>
        </p>
        <p class="soon">{demosStub}</p>
      </section>
    </main>

    <footer>
      Built on <a href={links.piDurable}>Pi Durable</a>
    </footer>
  </div>
</Shell>

<style>
  .page {
    max-width: 40rem;
    margin-inline: auto;
    padding: 2.5rem 1rem 3rem;
    text-align: center;
  }

  .top {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }

  .brand {
    display: grid;
    justify-items: center;
    gap: 0.875rem;
    text-decoration: none;
  }

  .word {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-right: -0.3em;
  }

  /* The mark: an outline and a solid square that slowly eclipse. */
  .mark {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
  }

  .outline,
  .solid {
    position: absolute;
    inset: 0;
    width: 1.5rem;
    height: 1.5rem;
  }

  .outline {
    border: 1.5px solid var(--text);
    translate: 0.75rem 0;
  }

  .solid {
    background: var(--block);
    translate: 0 0.75rem;
    animation: eclipse 12s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes eclipse {
    0%,
    15% {
      translate: 0 0.75rem;
    }
    45%,
    60% {
      translate: 0.75rem 0;
    }
    90%,
    100% {
      translate: 0 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .solid {
      animation: none;
    }
  }

  nav {
    display: flex;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--rule-strong);
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .intro {
    padding-top: clamp(3.5rem, 11vw, 6rem);
  }

  /* A short centred rule between sections carries the rhythm. */
  main > section + section::before {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    margin: clamp(3rem, 9vw, 4.5rem) auto;
    background: var(--rule-strong);
  }

  h1 {
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lede {
    max-width: 32rem;
    margin: 1.5rem auto 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  .script {
    padding: 1.25rem;
    background: var(--block);
    color: var(--on-block);
    text-align: left;
  }

  .script :focus-visible {
    outline-color: var(--on-block);
  }

  .line + .line {
    margin-top: 1rem;
  }

  .comment {
    font-size: 0.8125rem;
    color: var(--on-block-muted);
  }

  .run {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .run code {
    flex: 1;
    min-width: 0;
    font-size: 0.8125rem;
    word-break: break-all;
  }

  button {
    flex: none;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    background: none;
    color: var(--on-block);
    border: 1px solid var(--on-block-rule);
    border-radius: 0;
    cursor: pointer;
  }

  button:hover {
    border-color: var(--on-block);
  }

  .note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .note a {
    color: var(--text);
  }

  .names {
    display: grid;
    gap: 2.25rem;
    padding: 0;
    list-style: none;
  }

  .names h3 {
    font-size: clamp(1.25rem, 3.6vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .names p {
    max-width: 28rem;
    margin: 0.375rem auto 0;
    color: var(--muted);
  }

  .go {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2rem;
    font-weight: 600;
  }

  .go a::after {
    content: ' →';
    color: var(--accent);
  }

  .soon {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  footer {
    margin-top: clamp(4rem, 12vw, 7rem);
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
