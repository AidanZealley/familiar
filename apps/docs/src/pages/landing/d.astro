---
// Refinement D, "Conversation": faint chat-shaped outlines on the right of the
// header. Every few seconds the stack eases up by one bubble, so a new one
// rises from below and the oldest leaves through the top: a conversation that
// keeps going. The bubbles hold only blank line strokes, never words.
import Hero from '../../landing/sheet/Hero.astro'
import Sheet from '../../landing/sheet/Sheet.astro'

// side: who "speaks"; width: bubble width (%); lines: stroke widths (%).
const bubbles = [
  { side: 'them', width: 78, lines: [92, 64] },
  { side: 'you', width: 52, lines: [80] },
  { side: 'them', width: 86, lines: [96, 88, 40] },
  { side: 'you', width: 64, lines: [90, 52] },
  { side: 'them', width: 70, lines: [84] },
  { side: 'you', width: 44, lines: [70] },
]

// Two copies, so the loop wraps seamlessly.
const stack = [...bubbles, ...bubbles]
---

<Sheet title="Familiar · Landing D" home="/familiar/landing/d/">
  <Hero>
    <ol class="talk" slot="art">
      {
        stack.map((bubble) => (
          <li class={bubble.side} style={`--w: ${bubble.width}%`}>
            <span class="bubble">
              {bubble.lines.map((line) => (
                <i style={`width: ${line}%`} />
              ))}
            </span>
          </li>
        ))
      }
    </ol>
  </Hero>
</Sheet>

<style>
  .talk {
    --slot: 5.25rem;
    --steps: 6;
    position: absolute;
    inset: 0 0 auto;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .talk li {
    display: flex;
    align-items: flex-end;
    height: var(--slot);
    padding-bottom: 0.75rem;
  }

  .talk li.you {
    justify-content: flex-end;
  }

  .bubble {
    display: grid;
    gap: 0.5rem;
    width: var(--w);
    padding: 0.875rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 1rem 1rem 1rem 0.25rem;
  }

  .you .bubble {
    border-color: transparent;
    background: color-mix(in oklch, var(--accent) 9%, transparent);
    border-radius: 1rem 1rem 0.25rem 1rem;
  }

  .bubble i {
    display: block;
    height: 0.375rem;
    border-radius: 1rem;
    background: color-mix(in oklch, var(--text) 7%, transparent);
  }

  .you .bubble i {
    background: color-mix(in oklch, var(--accent) 18%, transparent);
  }

  /* Six steps over 36s: a short ease up, then a long rest. Each step is one
     slot, i.e. 1/12 of the doubled stack. */
  @media (prefers-reduced-motion: no-preference) {
    .talk {
      animation: converse 36s cubic-bezier(0.45, 0, 0.2, 1) infinite;
    }
  }

  @keyframes converse {
    0%,
    14% {
      translate: 0 0;
    }
    16.667%,
    30.667% {
      translate: 0 calc(-1 * var(--slot));
    }
    33.333%,
    47.333% {
      translate: 0 calc(-2 * var(--slot));
    }
    50%,
    64% {
      translate: 0 calc(-3 * var(--slot));
    }
    66.667%,
    80.667% {
      translate: 0 calc(-4 * var(--slot));
    }
    83.333%,
    97.333% {
      translate: 0 calc(-5 * var(--slot));
    }
    100% {
      translate: 0 calc(-6 * var(--slot));
    }
  }

  @media (max-width: 56rem) {
    .talk {
      --slot: 3.75rem;
    }

    .talk li {
      padding-bottom: 0.5rem;
    }

    .bubble {
      gap: 0.375rem;
      padding: 0.625rem 0.75rem;
    }

    .talk li {
      padding-inline: 8%;
    }
  }
</style>
