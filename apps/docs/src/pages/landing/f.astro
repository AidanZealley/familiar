---
// Refinement F, "Reflow": a quiet arrangement of flat panels on the right of
// the header that slowly re-proportions itself between a few layouts, the way
// one thing settles into different hosts and apps. Abstract blocks only.
import Hero from '../../landing/sheet/Hero.astro'
import Sheet from '../../landing/sheet/Sheet.astro'
---

<Sheet title="Familiar · Landing F" home="/familiar/landing/f/">
  <Hero>
    <div class="board" slot="art">
      <span class="p a"></span>
      <span class="p b"></span>
      <span class="p c"></span>
      <span class="p d"></span>
      <span class="p e"></span>
    </div>
  </Hero>
</Sheet>

<style>
  /* Three columns and three rows whose sizes change; the panels keep their
     grid lines, so they grow and shrink together without overlapping. */
  .board {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 1fr 2fr 1fr;
    gap: 0.5rem;
  }

  .p {
    min-width: 0;
    min-height: 0;
  }

  .a {
    grid-area: 1 / 1 / 3 / 2;
    background: var(--surface);
  }

  .b {
    grid-area: 1 / 2 / 2 / 4;
    border: 1px solid var(--rule-strong);
  }

  .c {
    grid-area: 2 / 2 / 3 / 3;
    background: color-mix(in oklch, var(--accent) 16%, transparent);
  }

  .d {
    grid-area: 2 / 3 / 4 / 4;
    background: var(--surface-2);
  }

  .e {
    grid-area: 3 / 1 / 4 / 3;
    border: 1px solid var(--rule-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .board {
      animation: reflow 30s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
  }

  /* Hold each layout, then ease to the next. */
  @keyframes reflow {
    0%,
    24% {
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: 1fr 2fr 1fr;
    }
    33%,
    57% {
      grid-template-columns: 1fr 1fr 2fr;
      grid-template-rows: 2fr 1fr 1fr;
    }
    66%,
    90% {
      grid-template-columns: 1fr 2fr 1fr;
      grid-template-rows: 1fr 1fr 2fr;
    }
    100% {
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: 1fr 2fr 1fr;
    }
  }

  @media (max-width: 56rem) {
    .board {
      gap: 0.375rem;
    }
  }
</style>
