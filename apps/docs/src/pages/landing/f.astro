---
// Refinement F, "Horizon": baseline A's headline beside a flat violet panel,
// a small day-and-night scene. Home and devices sit on the horizon; the sun
// and moon share one arc above it, and ruled lines below read like pages
// being kept. Motion: scrolling the page turns the arc, so the sun sets and
// the moon rises; without scroll-driven animation it rests at morning.
import {
  House,
  Laptop,
  Moon,
  Smartphone,
  Sun,
} from '@lucide/astro'
import { headline, pitch } from '../../landing/content'
import Sheet from '../../landing/sheet/Sheet.astro'
import Spec from '../../landing/sheet/Spec.astro'
---

<Sheet title="Familiar · Landing F" home="/familiar/landing/f/">
  <section class="sheet-wrap hero">
    <div class="copy">
      <h1>{headline}</h1>
      <p class="lede">{pitch}</p>
      <div class="spec-row"><Spec /></div>
    </div>

    <div class="scene" aria-hidden="true">
      <div class="sky">
        <span class="arc"></span>
        <span class="arm">
          <span class="body sun"><Sun size={18} /></span>
          <span class="body moon"><Moon size={18} /></span>
        </span>
      </div>
      <div class="ground">
        <span class="skyline">
          <House size={20} />
          <Laptop size={20} />
          <Smartphone size={16} />
        </span>
        <span class="lines"><i></i><i></i><i></i><i></i></span>
      </div>
    </div>
  </section>
</Sheet>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 1.5rem;
    padding-top: clamp(3rem, 8vw, 6rem);
  }

  .copy {
    grid-column: 1 / span 8;
    align-self: end;
  }

  h1 {
    font-size: clamp(2.125rem, 5vw, 4.25rem);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .lede {
    max-width: 38rem;
    margin-top: 2rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--muted);
    text-wrap: pretty;
  }

  .spec-row {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .spec-row :global(.spec) {
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }

  /* The scene: sky over ground, split at the horizon. */
  .scene {
    --r: 34%;
    grid-column: 9 / span 4;
    display: grid;
    grid-template-rows: 3fr 2fr;
    min-height: 24rem;
    background: var(--block);
    color: var(--on-block);
  }

  .sky {
    position: relative;
    overflow: hidden;
    container-type: size;
  }

  .arc {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 88cqw;
    aspect-ratio: 1;
    translate: -50% 50%;
    border: 1px dashed var(--on-block-rule);
    border-radius: 50%;
  }

  /* One arm carries both bodies, opposite each other; the bodies counter-
     rotate so their icons stay upright. */
  @property --turn {
    syntax: '<angle>';
    inherits: true;
    initial-value: 55deg;
  }

  .arm {
    --turn: 55deg;
    position: absolute;
    left: 50%;
    bottom: 0;
    rotate: var(--turn);
  }

  .body {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: -1.25rem 0 0 -1.25rem;
    rotate: calc(-1 * var(--turn));
  }

  .sun {
    translate: -44cqw 0;
    background: var(--on-block);
    color: var(--block);
  }

  .moon {
    translate: 44cqw 0;
    border: 1px solid var(--on-block-muted);
    color: var(--on-block);
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .arm {
        animation-name: dusk;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0px 70vh;
      }
    }
  }

  @keyframes dusk {
    from {
      --turn: 55deg;
    }
    to {
      --turn: 235deg;
    }
  }

  .ground {
    position: relative;
    border-top: 1px solid var(--on-block);
  }

  .skyline {
    position: absolute;
    left: 50%;
    top: 0;
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    translate: -50% -100%;
    padding-bottom: 0.375rem;
    color: var(--on-block);
  }

  .lines {
    position: absolute;
    inset: 1.5rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .lines i {
    height: 1px;
    background: var(--on-block-rule);
  }

  .lines i:nth-child(even) {
    width: 72%;
  }

  @media (max-width: 56rem) {
    .copy {
      grid-column: 1 / -1;
    }

    .scene {
      grid-column: 1 / -1;
      min-height: 0;
      height: clamp(11rem, 40vw, 16rem);
      margin-top: 2.5rem;
      grid-template-rows: 2fr 1fr;
    }

    .arc {
      width: 60cqw;
    }

    .sun {
      translate: -30cqw 0;
    }

    .moon {
      translate: 30cqw 0;
    }

    .lines {
      inset: 0.75rem 1.5rem;
    }
  }
</style>
