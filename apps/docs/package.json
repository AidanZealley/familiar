{
  "name": "@familiar-ai/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:demos && astro dev --host",
    "build": "pnpm build:demos && astro build && node scripts/check-links.ts",
    "build:demos": "pnpm build:demo:embedded-kanban && pnpm build:demo:shared-conversation",
    "build:demo:embedded-kanban": "pnpm --filter @familiar-example/embedded-kanban build --base=/familiar/demos/embedded-kanban/ --outDir=../../apps/docs/public/demos/embedded-kanban --emptyOutDir",
    "build:demo:shared-conversation": "pnpm --filter @familiar-example/shared-conversation build --base=/familiar/demos/shared-conversation/ --outDir=../../apps/docs/public/demos/shared-conversation --emptyOutDir",
    "preview": "astro preview --host",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/astro": "^1.66.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@familiar-ai/client": "workspace:*",
    "@familiar-ai/core": "workspace:*",
    "@types/react": "^19",
    "hono": "catalog:",
    "react": "^19.3.1",
    "typescript": "~6.0.3"
  }
}
